{
  "name": "foreslash",
  "version": "0.4.0-snapshot.3",
  "description": "Foreslash is a Javascript utilities lib which contains plenty of practical functions.",
  "author": "moushu",
  "license": "Mulan PSL v2",
  "bugs": {
    "url": "https://github.com/Moushudyx/foreslash/issues"
  },
  "homepage": "https://github.com/Moushudyx/foreslash#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moushudyx/foreslash.git"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "module": "lib/index.mjs",
  "browser": "lib/index.umd.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cmn.cjs"
    },
    "./umd": "./lib/index.umd.js"
  },
  "files": [
    "lib",
    "skills",
    "README.EN.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rolldown -c -w",
    "build": "rolldown -c",
    "build:rollup": "rollup -c",
    "test": "node scripts/run-vitest-guarded.mjs run --coverage --exclude test/build/** --exclude test/**/*.benchmark.test.ts",
    "test:slow": "node scripts/run-vitest-guarded.mjs run --coverage --no-file-parallelism --exclude test/build/** --exclude test/**/*.benchmark.test.ts",
    "test:benchmark": "node scripts/run-vitest-guarded.mjs run .benchmark.test.ts --reporter=verbose",
    "test:full": "node scripts/run-vitest-guarded.mjs run --coverage --exclude test/build/** --run-benchmark",
    "test:smoke": "vitest run test/build/smoke.test.ts test/build/umd.test.ts",
    "test:dts": "tsc --noEmit --project test/build/tsconfig.dts.json",
    "test:build": "pnpm run build && pnpm run test:smoke",
    "prepublishOnly": "pnpm test:full && pnpm test:build",
    "docs:dev": "rolldown -c && vitepress dev docs",
    "docs:build": "rolldown -c && vitepress build docs",
    "docs:preview": "rolldown -c && vitepress preview docs"
  },
  "keywords": [
    "foreslash",
    "lib",
    "util",
    "typescript",
    "functional"
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^24.1.3",
    "rolldown": "^1.0.0",
    "rolldown-plugin-dts": "^0.25.1",
    "rollup": "^4.38.0",
    "rollup-plugin-dts": "^6.2.1",
    "sass-embedded": "^1.90.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.2",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ts-toolbelt": "^9.6.0"
  }
}
